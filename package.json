{
  "name": "dugunsite",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "deploy:redirect-tr": "wrangler deploy --config wrangler.redirect-tr.toml",
    "db:local": "wrangler d1 migrations apply dugunsite-db --local",
    "db:remote": "wrangler d1 migrations apply dugunsite-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.38.0"
  }
}
